FRONTEND_PORT=3000
API_UPSTREAM=http://backend:8000

# Accounts and anonymous sessions. Generate a production secret with:
# openssl rand -hex 32
AUTH_COOKIE_SECRET=development-only-change-this-cookie-secret
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_VISITOR_TTL_SECONDS=7776000

# Gateway security and Redis-backed rate limits.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_REQUEST_BYTES=2097152
TRUST_PROXY_HEADERS=true
LOG_HASH_SALT=development-log-hash-salt
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_GENERAL_REQUESTS=120
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_EXTRACT_REQUESTS=10

POSTGRES_DB=knowledge_graph
POSTGRES_USER=kg
POSTGRES_PASSWORD=kg

# OpenRouter secrets stay in backend containers.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PROXY_URL=

# Host port for optional direct MongoDB inspection.
WIKONTIC_MONGO_PORT=27018
WIKONTIC_TIMEOUT_SECONDS=170

# Initialized with: docker compose --profile setup run --rm wikontic-init
# Add compatible profiles as a comma-separated list when needed.
WIKONTIC_PROFILES=en__contriever

LLM_LOG_LEVEL=preview

# Celery extraction worker.
CELERY_WORKER_CONCURRENCY=2
CELERY_TASK_TIME_LIMIT_SECONDS=300
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=270
EXTRACTION_JOB_MAX_RETRIES=3
EXTRACTION_JOB_RETRY_BACKOFF_SECONDS=30

# Extraction policy and cost/abuse guardrails.
MAX_EXTRACTION_CHARS=100000
MAX_ACTIVE_JOBS_PER_WORKSPACE=3
# Comma-separated OpenRouter model ids anonymous (not logged-in) visitors may
# use. Leave unset to fall back to a single cheap default model.
ANONYMOUS_MODEL_ALLOWLIST=google/gemini-2.5-flash-lite

# Celery Beat job recovery: reclaims jobs stuck queued (broker was down at
# enqueue time) or running (worker crashed mid-task) beyond their staleness
# window, up to a limited number of attempts before giving up.
JOB_RECOVERY_SWEEP_SECONDS=60
QUEUED_JOB_STALE_SECONDS=120
RUNNING_JOB_STALE_SECONDS=600
JOB_RECOVERY_MAX_ATTEMPTS=3
JOB_RECOVERY_BATCH_SIZE=100

# MinIO (S3-compatible) object storage for uploaded PDFs. The browser uploads
# directly via a presigned URL, so MINIO_PUBLIC_ENDPOINT must be a host it can
# reach -- not the internal docker-network hostname.
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=kg-documents

# PDF/URL ingestion limits and worker settings.
MAX_PDF_UPLOAD_BYTES=20971520
URL_FETCH_TIMEOUT_SECONDS=15
MAX_URL_CONTENT_BYTES=5242880
MAX_URL_REDIRECTS=5
INGESTION_WORKER_CONCURRENCY=2
INGESTION_MAX_RETRIES=2
INGESTION_RETRY_BACKOFF_SECONDS=20

# Email verification / password reset token lifetimes. Delivery is a
# log-only placeholder until a real provider (SMTP/Resend/etc.) is wired
# up -- see "Hesap yönetimi genişletmeleri" in the README.
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600

# Celery Beat maintenance sweeps: anonymous visitor cleanup, orphaned
# MinIO object cleanup, and periodic Wikontic (MongoDB + embedding
# profile) health checks. See "Bakım cron görevleri" in the README.
VISITOR_CLEANUP_SWEEP_SECONDS=86400
VISITOR_CLEANUP_BATCH_SIZE=500
ORPHAN_STORAGE_SWEEP_SECONDS=21600
ORPHAN_UPLOAD_GRACE_SECONDS=86400
WIKONTIC_HEALTH_CHECK_SWEEP_SECONDS=300
MAINTENANCE_HEALTH_CHECK_TIMEOUT_SECONDS=10
