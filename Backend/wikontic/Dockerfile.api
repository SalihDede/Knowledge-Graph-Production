FROM python:3.11-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HOME=/models/huggingface \
    TRANSFORMERS_CACHE=/models/huggingface

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential git curl libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-api.txt ./
RUN pip install --no-cache-dir -r requirements-api.txt

COPY . .

FROM base AS test

RUN pip install --no-cache-dir -r requirements-test.txt
CMD ["python", "-m", "pytest", "-q"]

FROM base AS runtime

EXPOSE 8001

HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=4 \
  CMD curl --fail --silent http://127.0.0.1:8001/health/live >/dev/null || exit 1

CMD ["uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8001"]
